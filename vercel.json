{
  "installCommand": "corepack enable && corepack prepare pnpm@10.34.5 --activate && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/y-connect run build",
  "outputDirectory": "artifacts/y-connect/dist/public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "artifacts/api-server/src/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
